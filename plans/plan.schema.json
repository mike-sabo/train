{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,80}$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "schedule": {
      "type": "string",
      "maxLength": 100
    },
    "weeks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52
    },
    "notes": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "days": {
      "minItems": 1,
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,80}$"
          },
          "weekday": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "focus": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "exercises": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,80}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "sets": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "reps": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "demo": {
                  "type": "object",
                  "properties": {
                    "instructor": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https:\\/\\/www\\.youtube\\.com\\/watch\\?v=[\\w-]{11}$"
                    },
                    "verifiedOn": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    },
                    "verification": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "required": [
                    "instructor",
                    "url",
                    "verifiedOn",
                    "verification"
                  ],
                  "additionalProperties": false
                },
                "substitutions": {
                  "default": [],
                  "maxItems": 5,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]{1,80}$"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "sets": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "reps": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "demo": {
                        "type": "object",
                        "properties": {
                          "instructor": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "url": {
                            "type": "string",
                            "pattern": "^https:\\/\\/www\\.youtube\\.com\\/watch\\?v=[\\w-]{11}$"
                          },
                          "verifiedOn": {
                            "type": "string",
                            "format": "date",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                          },
                          "verification": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                          }
                        },
                        "required": [
                          "instructor",
                          "url",
                          "verifiedOn",
                          "verification"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": ["id", "name", "sets", "reps", "demo"],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "name",
                "sets",
                "reps",
                "demo",
                "substitutions"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "weekday", "name", "focus", "exercises"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "description",
    "schedule",
    "weeks",
    "notes",
    "days"
  ],
  "additionalProperties": false
}
