    "test:cloud": "node --test tests/cloud/*.test.js",
    "test:cloud:local": "node scripts/test-cloud-local.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  }
}
